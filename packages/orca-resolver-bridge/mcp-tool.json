{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "mcp_resolve_element",
  "title": "Resolve Orca Design Mode element capture",
  "description": "Resolve an element captured by Orca Design Mode against the live page. Primary path: exact backendDOMNodeId resolution at confidence 1.0. Fallback: structural match on DOM plus computed styles when the node is stale, with reduced confidence and fallback-match metadata. When the request carries an action, the Action Engine executes it and the Verification Engine confirms via state-diff. Success is state changed, never selector presence. Contract: docs/IDD-016-orca-resolver-bridge-v1.md, schema_version 1.0.0.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://edgegde.dev/schemas/orca-resolver-bridge/v1.0.0/orca-resolver-request.schema.json",
    "title": "OrcaResolverBridgeRequest",
    "description": "Orca Design Mode element capture request to the Hermes State Engine Resolver (FRS-005). Contract IDD-016 v1.0.0. All field names are snake_case. Enum values are snake_case.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "request_id",
      "captured_at",
      "page",
      "element"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0.0",
        "description": "Bridge contract version. Major version changes are breaking. The resolver MUST reject unknown versions with UNSUPPORTED_SCHEMA_VERSION."
      },
      "request_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "description": "UUIDv4 generated by the caller. Idempotency key. The resolver caches the response for this id for 60s and replays it on retry without re-executing any action."
      },
      "captured_at": {
        "type": "string",
        "format": "date-time",
        "description": "UTC ISO-8601 timestamp of the capture, from the capturing CDP session clock."
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000,
        "default": 10000,
        "description": "Caller-side budget for resolution plus optional action execution. The resolver returns RESOLVER_TIMEOUT when this budget is exceeded."
      },
      "page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "target_id",
          "viewport"
        ],
        "description": "Page context the element was captured from. The resolver MUST operate on this exact target.",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Document URL at capture time."
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "description": "CDP Target.targetId of the tab that holds the element. backendDOMNodeId is only meaningful within this target."
          },
          "title": {
            "type": "string",
            "description": "Document title at capture time."
          },
          "frame_id": {
            "type": "string",
            "description": "CDP Page.frameId of the frame that owns the element. Omit for the main frame."
          },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "device_pixel_ratio": {
            "type": "number",
            "minimum": 0,
            "description": "Window.devicePixelRatio at capture time."
          }
        }
      },
      "element": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backend_dom_node_id",
          "dom_snapshot",
          "computed_styles",
          "geometry",
          "screenshot"
        ],
        "description": "The captured element. Capture via CDP from the click target, including elements rendered inside Radix portals.",
        "properties": {
          "backend_dom_node_id": {
            "type": "integer",
            "minimum": 0,
            "description": "CDP DOM backendNodeId of the clicked element. Exact handle for the confidence 1.0 fast path."
          },
          "dom_snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outer_html",
              "tag",
              "ancestor_path",
              "structural_hash",
              "truncated"
            ],
            "properties": {
              "outer_html": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000,
                "description": "outerHTML of the element subtree (CDP DOM.getOuterHTML). Truncate at the last complete tag beyond 200000 chars and set truncated=true."
              },
              "tag": {
                "type": "string",
                "minLength": 1,
                "description": "Lowercase tag name of the element, e.g. button, input, div."
              },
              "attributes": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Element attributes as string key-value pairs. Include id, name, class, type, placeholder, aria-label, aria-describedby, role, href, title, data-testid when present. Omit absent attributes."
              },
              "text_content": {
                "type": "string",
                "maxLength": 2000,
                "description": "Trimmed textContent of the element."
              },
              "ancestor_path": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "description": "Ancestor chain ordered nearest-ancestor-first, up to 8 entries, ending at html. Each step carries the 1-based index among same-tag siblings.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "tag",
                    "index"
                  ],
                  "properties": {
                    "tag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "id": {
                      "type": "string"
                    },
                    "classes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "structural_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA-256 hex over the canonical structural string. Canonical string = ancestor_path segments nearest-first, then the element itself, joined by '|'. Each segment = tag:index:id (id empty when absent). Example: div:3:|div:1:asset-form|html:1:|button:1:save-btn"
              },
              "child_count": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of direct child elements."
              },
              "truncated": {
                "type": "boolean",
                "default": false,
                "description": "True when outer_html was truncated at the 200000 char cap."
              }
            }
          },
          "computed_styles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "display",
              "visibility",
              "opacity",
              "pointer-events",
              "cursor",
              "color",
              "background-color",
              "font-size",
              "font-weight",
              "text-align"
            ],
            "description": "Exact subset of CDP CSS.getComputedStyle output. Keys are kebab-case exactly as CDP returns them. Values are the raw strings.",
            "properties": {
              "display": {
                "type": "string"
              },
              "visibility": {
                "type": "string"
              },
              "opacity": {
                "type": "string"
              },
              "pointer-events": {
                "type": "string"
              },
              "cursor": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "background-color": {
                "type": "string"
              },
              "font-size": {
                "type": "string"
              },
              "font-weight": {
                "type": "string"
              },
              "text-align": {
                "type": "string"
              }
            }
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height",
              "coordinate_space"
            ],
            "description": "Element bounding box from CDP DOM.getBoxModel or getContentQuads, collapsed to the first quad.",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "minimum": 0
              },
              "height": {
                "type": "number",
                "minimum": 0
              },
              "coordinate_space": {
                "const": "viewport",
                "description": "Coordinates are CSS pixels relative to the viewport origin."
              }
            }
          },
          "portal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "in_portal"
            ],
            "description": "Portal rendering context. Elements inside Radix portals live under a portal root outside the main React tree. They still have valid backendDOMNodeIds and MUST be captured.",
            "properties": {
              "in_portal": {
                "type": "boolean",
                "description": "True when the element's nearest portal ancestor exists (e.g. under div[data-radix-portal] or document.body > div portal root)."
              },
              "portal_root_hint": {
                "type": "string",
                "description": "Selector hint for the portal root container, when in_portal is true."
              }
            }
          },
          "screenshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "storage",
              "mime_type",
              "width",
              "height"
            ],
            "description": "Element screenshot reference. Use data_uri for element clips up to 4MB encoded. Use blob_ref beyond that.",
            "properties": {
              "storage": {
                "type": "string",
                "enum": [
                  "data_uri",
                  "blob_ref"
                ],
                "description": "data_uri embeds the image inline. blob_ref references a blob the caller holds."
              },
              "data_uri": {
                "type": "string",
                "maxLength": 4000000,
                "description": "Data URI of the element clip. Required when storage=data_uri. Pattern: data:image/png;base64,... or data:image/jpeg;base64,..."
              },
              "blob_id": {
                "type": "string",
                "minLength": 1,
                "description": "Caller-scoped blob identifier. Required when storage=blob_ref."
              },
              "blob_url": {
                "type": "string",
                "format": "uri",
                "description": "Optional URL the resolver can use to fetch the blob when it shares the caller's origin."
              },
              "blob_expires_at": {
                "type": "string",
                "format": "date-time",
                "description": "When the blob reference stops being valid."
              },
              "mime_type": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg"
                ]
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA-256 hex of the raw image bytes. Enables integrity checks and dedupe."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "storage": {
                      "const": "data_uri"
                    }
                  },
                  "required": [
                    "storage"
                  ]
                },
                "then": {
                  "required": [
                    "data_uri"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "storage": {
                      "const": "blob_ref"
                    }
                  },
                  "required": [
                    "storage"
                  ]
                },
                "then": {
                  "required": [
                    "blob_id"
                  ]
                }
              }
            ]
          }
        }
      },
      "action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "description": "Optional intended operation. When present, the resolver resolves the element and the Action Engine executes the operation, then the Verification Engine confirms via state-diff. When absent, the response carries resolution and action_hints only.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "click",
              "fill",
              "type",
              "select",
              "hover"
            ]
          },
          "value": {
            "type": "string",
            "maxLength": 100000,
            "description": "Value for fill, type, or select. Omit for click and hover."
          },
          "submit": {
            "type": "boolean",
            "default": false,
            "description": "For type: press Enter after typing."
          }
        }
      },
      "context": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "app": {
            "type": "string",
            "description": "Application identifier, e.g. salestrekker. Used to scope known-bug registry consultation."
          },
          "locale": {
            "type": "string",
            "description": "Page locale, e.g. en-AU."
          },
          "hints": {
            "type": "object",
            "description": "Free-form caller hints. Reserved. The resolver MUST NOT treat hints as authoritative."
          }
        }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://edgegde.dev/schemas/orca-resolver-bridge/v1.0.0/orca-resolver-response.schema.json",
    "title": "OrcaResolverBridgeResponse",
    "description": "Resolver response for an Orca Design Mode capture request. Contract IDD-016 v1.0.0. Carries either a resolution or an error, never both.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "request_id",
      "resolved_at",
      "resolver"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0.0",
        "description": "Bridge contract version of this response."
      },
      "request_id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "description": "Echo of the request id. Lets the caller correlate retries and idempotent replays."
      },
      "resolved_at": {
        "type": "string",
        "format": "date-time",
        "description": "UTC ISO-8601 timestamp when the resolver produced this response."
      },
      "resolver": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "latency_ms",
          "node_live",
          "target_id"
        ],
        "properties": {
          "version": {
            "type": "string",
            "description": "State engine build version, e.g. state-engine@1.4.2."
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0,
            "description": "Resolver processing time for this request."
          },
          "node_live": {
            "type": "boolean",
            "description": "Whether the requested backendDOMNodeId resolved live in the target. False on the fallback path."
          },
          "target_id": {
            "type": "string",
            "description": "CDP target the resolution ran against. Must equal request.page.target_id."
          }
        }
      },
      "resolution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "resolution_path",
          "confidence",
          "element_ref",
          "strategy",
          "element_type",
          "action_hints",
          "known_bug_flags",
          "known_bug_workarounds",
          "fallback_match"
        ],
        "description": "Present on success. Absent when error is present.",
        "properties": {
          "status": {
            "const": "resolved",
            "description": "Frozen at resolved for v1. A response without an error always carries a usable resolution."
          },
          "resolution_path": {
            "type": "string",
            "enum": [
              "exact_backend_node",
              "fallback_structural"
            ],
            "description": "exact_backend_node: live backendDOMNodeId, confidence exactly 1.0. fallback_structural: node stale, matched on DOM structure and computed styles, confidence below 1.0."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Resolution confidence in [0,1]. Exactly 1.0 on the exact_backend_node path. Below 1.0 on fallback_structural. Below 0.5 the resolver MUST NOT return a resolution and returns ELEMENT_NOT_RESOLVABLE instead."
          },
          "element_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "backend_dom_node_id",
              "selector",
              "ax_node_id",
              "bounds",
              "frame_id",
              "target_id"
            ],
            "description": "Resolved element reference for the Action Engine. Execution addresses backend_dom_node_id. selector is a human-readable hint only.",
            "properties": {
              "backend_dom_node_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Live backend DOM node id. Null only when the resolver could not re-obtain a node handle, which requires action_hints to be empty."
              },
              "selector": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Best-effort CSS selector hint. Not authoritative. The Action Engine MUST NOT depend on it."
              },
              "ax_node_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Accessibility tree node id when available."
              },
              "bounds": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "frame_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "CDP frame id owning the element."
              },
              "target_id": {
                "type": "string",
                "description": "CDP target id owning the element."
              }
            }
          },
          "strategy": {
            "type": "string",
            "enum": [
              "backend_node_exact",
              "structural_styles_match"
            ],
            "description": "Resolution strategy that produced element_ref."
          },
          "element_type": {
            "type": "string",
            "enum": [
              "button",
              "combobox",
              "text_input",
              "link",
              "checkbox",
              "radio",
              "dialog_button",
              "menu_item",
              "table_cell",
              "container",
              "other"
            ],
            "description": "Semantic element type. Drives action compatibility checks and tier priorities."
          },
          "action_hints": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "click",
                "fill",
                "type",
                "select",
                "hover"
              ]
            },
            "uniqueItems": true,
            "description": "Actions the resolved element supports. The Action Engine uses this to reject incompatible operations with ACTION_REJECTED."
          },
          "known_bug_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "default": [],
            "description": "Known-bug registry ids applicable to this element. Initial registry: radix_portal_block, react_props_fallback, false_positive_save."
          },
          "known_bug_workarounds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bug_id",
                "workaround",
                "applied"
              ],
              "properties": {
                "bug_id": {
                  "type": "string"
                },
                "workaround": {
                  "type": "string",
                  "description": "Workaround instruction for the Action Engine."
                },
                "applied": {
                  "type": "boolean",
                  "description": "Whether the resolver applied the workaround at resolution time. Execution-time workarounds report applied=false here and are enforced by the Action Engine."
                },
                "reason": {
                  "type": "string",
                  "description": "When applied=false, why the workaround was not applied at resolution time."
                }
              }
            },
            "default": [],
            "description": "Workaround guidance per flagged bug."
          },
          "fallback_match": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "matched_on",
              "match_score",
              "differences",
              "candidate_count",
              "candidate_refs"
            ],
            "description": "Fallback-match metadata. Required and non-null when resolution_path=fallback_structural. Null on the exact path.",
            "properties": {
              "matched_on": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "dom_structure",
                    "computed_styles",
                    "text_content",
                    "geometry"
                  ]
                },
                "description": "Signals that produced the match."
              },
              "match_score": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 0.99,
                "description": "Weighted match score. Never 1.0 on the fallback path."
              },
              "differences": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Human-readable list of differences from the captured element, e.g. text or attribute drift."
              },
              "candidate_count": {
                "type": "integer",
                "minimum": 1,
                "description": "Number of candidate elements scored during fallback matching."
              },
              "candidate_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Selector hints for the top candidates, best first."
              }
            }
          },
          "action_outcome": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "requested_action",
              "executed",
              "verification",
              "rejection"
            ],
            "description": "Present when the request carried an action. Null otherwise.",
            "properties": {
              "requested_action": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "click",
                      "fill",
                      "type",
                      "select",
                      "hover"
                    ]
                  },
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "submit": {
                    "type": "boolean"
                  }
                }
              },
              "executed": {
                "type": "boolean",
                "description": "Whether the Action Engine dispatched the action. False when rejected."
              },
              "action_tier": {
                "type": "string",
                "enum": [
                  "REACT",
                  "CDP",
                  "KEY",
                  "JS",
                  "AX",
                  "OS"
                ],
                "description": "Tier that executed the action. Required when executed=true."
              },
              "verification": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "verified",
                  "method",
                  "state_changed",
                  "verdict",
                  "diff_summary"
                ],
                "description": "Verification Engine verdict. Null when the action was not executed. Success is state changed, never selector presence.",
                "properties": {
                  "verified": {
                    "type": "boolean",
                    "description": "True only when the state-diff confirms the expected change."
                  },
                  "method": {
                    "const": "state_diff"
                  },
                  "state_changed": {
                    "type": "boolean",
                    "description": "Whether before/after state snapshots differ."
                  },
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "verified",
                      "no_state_change",
                      "false_positive_detected",
                      "not_verified"
                    ],
                    "description": "verified: state changed as expected. no_state_change: action dispatched but state identical, reported as unverified. false_positive_detected: a known false-positive pattern matched, e.g. false_positive_save. not_verified: verification could not run."
                  },
                  "diff_summary": {
                    "type": "string",
                    "description": "Human-readable state-diff summary, e.g. input value changed, dialog opened."
                  },
                  "false_positive_guard": {
                    "type": "string",
                    "description": "Known-bug id that gated the verdict, e.g. false_positive_save."
                  }
                }
              },
              "rejection": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "code",
                  "reason_code",
                  "reason"
                ],
                "description": "In-band action rejection. Present when resolution succeeded but the action was declined. Null otherwise.",
                "properties": {
                  "code": {
                    "const": "ACTION_REJECTED"
                  },
                  "reason_code": {
                    "type": "string",
                    "enum": [
                      "confidence_below_policy",
                      "element_type_incompatible",
                      "known_bug_no_workaround",
                      "element_not_interactable"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Human-readable explanation."
                  }
                }
              }
            }
          }
        }
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable",
          "retry_policy"
        ],
        "description": "Present on failure. Absent on success. Mirrors orca-resolver-error.schema.json.",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "STALE_NODE",
              "ELEMENT_NOT_RESOLVABLE",
              "RESOLVER_TIMEOUT",
              "ACTION_REJECTED",
              "INVALID_REQUEST",
              "UNSUPPORTED_SCHEMA_VERSION",
              "TARGET_NOT_ATTACHED",
              "RESOLVER_UNREACHABLE",
              "INTERNAL_ERROR"
            ],
            "description": "Stable machine-readable error code. STALE_NODE, ELEMENT_NOT_RESOLVABLE, RESOLVER_TIMEOUT, ACTION_REJECTED are the four contract-mandated codes."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether an immediate retry with the same request_id can succeed."
          },
          "retry_policy": {
            "type": "string",
            "enum": [
              "none",
              "recapture",
              "reattach",
              "backoff"
            ],
            "description": "none: do not retry, fix the cause. recapture: caller must capture a fresh element and send a new request_id. reattach: resolver attaches to the target, caller retries once. backoff: retry with the documented delay ladder."
          },
          "details": {
            "type": "object",
            "description": "Code-specific structured context. INVALID_REQUEST carries validation_errors. STALE_NODE and ELEMENT_NOT_RESOLVABLE carry best_candidate when one exists."
          },
          "known_bug_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "default": [],
            "description": "Known-bug registry ids relevant to the failure, when applicable."
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true,
        "default": [],
        "description": "Non-fatal observations, e.g. truncated capture fields, degraded caches."
      }
    },
    "allOf": [
      {
        "if": {
          "required": [
            "error"
          ]
        },
        "then": {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "resolution"
            ]
          }
        }
      },
      {
        "if": {
          "not": {
            "required": [
              "error"
            ]
          }
        },
        "then": {
          "required": [
            "resolution"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "resolution": {
              "properties": {
                "resolution_path": {
                  "const": "fallback_structural"
                }
              },
              "required": [
                "resolution_path"
              ]
            }
          },
          "required": [
            "resolution"
          ]
        },
        "then": {
          "properties": {
            "resolution": {
              "properties": {
                "fallback_match": {
                  "type": "object"
                }
              },
              "required": [
                "fallback_match"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "resolution": {
              "properties": {
                "action_outcome": {
                  "properties": {
                    "executed": {
                      "const": true
                    }
                  },
                  "required": [
                    "executed"
                  ]
                }
              },
              "required": [
                "action_outcome"
              ]
            }
          },
          "required": [
            "resolution"
          ]
        },
        "then": {
          "properties": {
            "resolution": {
              "properties": {
                "action_outcome": {
                  "required": [
                    "action_tier"
                  ]
                }
              }
            }
          }
        }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "transport": {
    "primary": {
      "type": "mcp",
      "protocol": "streamable-http",
      "url_template": "http://127.0.0.1:{port}/mcp",
      "port_env": "STATE_ENGINE_PORT",
      "port_default": 9110,
      "tool_call_shape": "tools/call with name=mcp_resolve_element, arguments = the request object"
    },
    "fallback": {
      "type": "http",
      "method": "POST",
      "path": "/api/v1/resolver/resolve",
      "url_template": "http://127.0.0.1:{port}/api/v1/resolver/resolve",
      "port_env": "STATE_ENGINE_PORT",
      "port_default": 9110,
      "request_headers": {
        "Content-Type": "application/json",
        "X-Orca-Bridge-Version": "1.0.0"
      },
      "request_body": "The request object, byte-identical to the MCP tool arguments.",
      "success": "HTTP 200 with the response envelope.",
      "contract_errors": "HTTP status from schemas/error-codes.json http_status field, body is the same response envelope with error set.",
      "timeouts": {
        "connect_ms": 2000,
        "read_ms": "request.timeout_ms + 5000 grace"
      }
    }
  },
  "contract": {
    "version": "1.0.0",
    "document": "docs/IDD-016-orca-resolver-bridge-v1.md",
    "request_schema": "schemas/orca-resolver-request.schema.json",
    "response_schema": "schemas/orca-resolver-response.schema.json",
    "error_schema": "schemas/orca-resolver-error.schema.json",
    "error_registry": "schemas/error-codes.json",
    "examples": "examples/",
    "validator": "tools/validate_examples.py"
  }
}
