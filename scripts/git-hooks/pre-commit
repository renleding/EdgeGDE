#!/bin/bash
# Pre-commit hook: block commits with type errors before they reach CI
#
# Runs in apps/edge-runtime with bun. If typecheck fails, the commit is
# blocked and the full error output is shown.
#
# Install: git config core.hooksPath scripts/git-hooks
#
# To bypass: git commit --no-verify (only for genuine emergencies)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
WORK_DIR="$REPO_ROOT/apps/edge-runtime"

if [ ! -d "$WORK_DIR" ]; then
  echo "⚠️  EdgeGDE pre-commit hook: expected $WORK_DIR, skipping typecheck"
  exit 0
fi

cd "$WORK_DIR"

# Typecheck — exit code driven so errors are always shown
echo "🔍 Running typecheck..."
if ! bun run typecheck 2>&1; then
  echo ""
  echo "❌ Typecheck failed. Fix all type errors before committing."
  echo "   To bypass: git commit --no-verify (not recommended)"
  exit 1
fi

echo "✅ Typecheck passed"
exit 0
