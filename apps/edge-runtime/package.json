{
  "name": "@edgegde/runtime",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --config wrangler.local.toml",
    "deploy": "bash scripts/deploy.sh patch",
    "deploy:minor": "bash scripts/deploy.sh minor",
    "deploy:major": "bash scripts/deploy.sh major",
    "deploy:wrangler": "wrangler deploy",
    "test": "bash scripts/test-local.sh",
    "test:swarm": "tsx tests/domain-swarm.test.ts",
    "test:domain": "tsx tests/domain-workspace.test.ts",
    "test:renderer": "tsx tests/phase13-hypermedia.test.ts",
    "test:scoring": "tsx tests/scoring-engine.test.ts",
    "test:edr": "tsx tests/compiler/edr-engine.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@edgegde/schema": "workspace:*",
    "hono": "^4.12.5",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260525.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-plugin-local-rules": "^3.0.2",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}