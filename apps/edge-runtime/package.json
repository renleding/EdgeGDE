{
  "name": "@edgegde/runtime",
  "version": "0.9.5-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --config wrangler.local.toml",
    "build:pwa-canvas": "bun ../pwa-canvas/scripts/copy-static.mjs",
    "deploy": "bash scripts/deploy.sh patch",
    "deploy:minor": "bash scripts/deploy.sh minor",
    "deploy:major": "bash scripts/deploy.sh major",
    "deploy:wrangler": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "deploy:rollback": "wrangler rollback",
    "provision:staging": "bash scripts/provision-staging.sh",
    "test:e2e:staging": "EDGE_RUNTIME_BASE_URL=https://edgegde-calculator-staging.renleding.workers.dev vitest run --config vitest.e2e.config.ts",
    "test": "bash scripts/test-local.sh",
    "test:widget": "vitest run --config vitest.widget.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "test:swarm": "tsx tests/domain-swarm.test.ts",
    "test:domain": "tsx tests/domain-workspace.test.ts",
    "test:renderer": "tsx tests/phase13-hypermedia.test.ts",
    "test:scoring": "tsx tests/scoring-engine.test.ts",
    "test:edr": "tsx tests/compiler/edr-engine.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@edgegde/schema": "workspace:*",
    "brace-expansion": "^5.0.9",
    "hono": "^4.13.1",
    "sharp": "^0.35.3",
    "zod": "4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.19",
    "@cloudflare/workers-types": "^4.20260525.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.4.1",
    "eslint-plugin-local-rules": "^3.0.2",
    "happy-dom": "^20.10.6",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.0.0"
  }
}
