{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "assets": {
    "directory": "public"
  },
  "compatibility_date": "2025-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "1d24d306-9537-4386-929c-60c9e6d882b1",
      "database_name": "ebroker_leads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RateLimiter",
        "name": "RATE_LIMITER"
      },
      {
        "class_name": "AuditLedger",
        "name": "AUDIT_LEDGER"
      },
      {
        "class_name": "ChatSession_DO",
        "name": "CHAT_SESSION"
      },
      {
        "class_name": "CanvasSession_DO",
        "name": "CANVAS_SESSION"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "ARTIFACT_KV",
      "id": "95a35fb5eaa441bd9f6336b4ef894a57"
    },
    {
      "binding": "TENANT_KV",
      "id": "04893a14b75e41b281177bf558cf3e32"
    },
    {
      "binding": "TELEMETRY_KV",
      "id": "588cdc5578244acdbaed515dbbc175f7"
    }
  ],
  "main": "src/index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "RateLimiter"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "AuditLedger"
      ],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": [
        "ChatSession_DO"
      ],
      "tag": "v3"
    },
    {
      "new_sqlite_classes": [
        "CanvasSession_DO"
      ],
      "tag": "v4"
    }
  ],
  "name": "edgegde-calculator",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "queues": {
    "consumers": [
      {
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "queue": "edgegde-lead-scoring"
      },
      {
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "queue": "edgegde-forecasting"
      }
    ],
    "producers": [
      {
        "binding": "LEAD_SCORING_QUEUE",
        "queue": "edgegde-lead-scoring"
      },
      {
        "binding": "FORECASTING_QUEUE",
        "queue": "edgegde-forecasting"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "edgegde-vault"
    }
  ],
  "triggers": {
    "crons": [
      "0 8,20 * * *"
    ]
  },
  "vars": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://waters-eleven-crops-prot.trycloudflare.com",
    "OTEL_SERVICE_NAME": "edgegde-worker"
  },
  "env": {
    "production": {
      "name": "edgegde-calculator",
      "kv_namespaces": [
        { "binding": "ARTIFACT_KV", "id": "381fcc882dd147a9a0f8e706fb40064c" },
        { "binding": "TENANT_KV",   "id": "5a9096680bce482f94a897fe640bafe6" },
        { "binding": "TELEMETRY_KV","id": "78c1f43b67e9483e9f02ed66aa4ac8fc" }
      ],
      "queues": {
        "producers": [
          { "binding": "LEAD_SCORING_QUEUE", "queue": "edgegde-lead-scoring" },
          { "binding": "FORECASTING_QUEUE",  "queue": "edgegde-forecasting" }
        ]
      }
    }
  }
}