{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "assets": {
    "directory": "public"
  },
  "compatibility_date": "2025-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "a418b4ad-e33b-4088-8eb8-715b5945d10f",
      "database_name": "ebroker_leads_staging"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RateLimiter",
        "name": "RATE_LIMITER"
      },
      {
        "class_name": "AuditLedger",
        "name": "AUDIT_LEDGER"
      },
      {
        "class_name": "ChatSession_DO",
        "name": "CHAT_SESSION"
      },
      {
        "class_name": "CanvasSession_DO",
        "name": "CANVAS_SESSION"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "ARTIFACT_KV",
      "id": "95a35fb5eaa441bd9f6336b4ef894a57",
      "preview_id": "95a35fb5eaa441bd9f6336b4ef894a57"
    },
    {
      "binding": "TENANT_KV",
      "id": "04893a14b75e41b281177bf558cf3e32",
      "preview_id": "04893a14b75e41b281177bf558cf3e32"
    },
    {
      "binding": "TELEMETRY_KV",
      "id": "588cdc5578244acdbaed515dbbc175f7",
      "preview_id": "588cdc5578244acdbaed515dbbc175f7"
    }
  ],
  "main": "src/index.ts",
  "migrations": [
    {
      "new_sqlite_classes": [
        "RateLimiter"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "AuditLedger"
      ],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": [
        "ChatSession_DO"
      ],
      "tag": "v3"
    },
    {
      "new_sqlite_classes": [
        "CanvasSession_DO"
      ],
      "tag": "v4"
    }
  ],
  "name": "edgegde-calculator-staging",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "edgegde-vault-staging"
    }
  ],
  "queues": {
    "consumers": [
      {
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "queue": "edgegde-lead-scoring-staging"
      },
      {
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "queue": "edgegde-forecasting-staging"
      }
    ],
    "producers": [
      {
        "binding": "LEAD_SCORING_QUEUE",
        "queue": "edgegde-lead-scoring-staging"
      },
      {
        "binding": "FORECASTING_QUEUE",
        "queue": "edgegde-forecasting-staging"
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 8,20 * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://waters-eleven-crops-prot.trycloudflare.com",
    "OTEL_SERVICE_NAME": "edgegde-worker"
  }
}