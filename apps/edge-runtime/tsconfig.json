{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/compiler/edr-engine.test.ts", "tests/scoring-engine.test.ts", "tests/phase13-hypermedia.test.ts", "tests/domain-workspace.test.ts", "tests/domain-swarm.test.ts", "tests/storage-enforcement.test.ts", "scripts/validate-replay.ts"]
}
